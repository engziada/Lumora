<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- A launcher owns Back at its root so it remains on Home instead of finishing. -->
    <issue id="MissingSuperCall">
        <ignore path="app/src/main/java/com/firestick/aura/launcher/MainActivity.java" />
    </issue>
    <!-- These two TV screens pass the documented NORMAL (0) / BOLD (1) style values. -->
    <issue id="WrongConstant">
        <ignore path="app/src/main/java/com/firestick/aura/launcher/MainActivity.java" />
        <ignore path="app/src/main/java/com/firestick/aura/launcher/SettingsActivity.java" />
    </issue>
    <!-- A launcher must enumerate installed launchable apps; narrow package queries cannot express that catalogue. -->
    <issue id="QueryAllPackagesPermission">
        <ignore path="app/src/main/AndroidManifest.xml" />
    </issue>
</lint>
