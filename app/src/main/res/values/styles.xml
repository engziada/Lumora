<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: NOVA-style dark surface with the Poppins type family -->
    <style name="Theme.AuraLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/nova_bg</item>
        <item name="android:colorBackground">@color/nova_bg</item>
        <item name="android:textColorPrimary">@color/nova_text</item>
        <item name="android:textColorSecondary">@color/nova_text_dim</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="colorPrimary">@color/nova_accent</item>
        <item name="colorAccent">@color/nova_accent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

    <!-- Dialog theme (app action sheet, hidden-app list) -->
    <style name="Theme.AuraLauncher.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_glass</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">@color/nova_text</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="colorAccent">@color/nova_accent</item>
    </style>
</resources>
