<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Glass fills shared by every Lumora window theme (attrs.xml describes each role). -->
    <style name="Theme.Lumora.Glass" parent="Theme.AppCompat.NoActionBar">
        <item name="lumoraGlassPanel">@color/glass_panel_fill</item>
        <item name="lumoraGlassCard">@color/glass_card_fill</item>
        <item name="lumoraGlassControl">@color/glass_control_fill</item>
        <item name="lumoraGlassFocus">@color/glass_focus_fill</item>
        <item name="lumoraGlassPill">@color/glass_pill_fill</item>
        <item name="lumoraGlassSheet">@color/glass_sheet_fill</item>
        <item name="lumoraGlassBar">@color/glass_bar_fill</item>
        <item name="lumoraGlassInset">@color/glass_inset_fill</item>
    </style>

    <!-- Lumora base theme: cool ink surfaces, ice-white text and accent, glass fills, Poppins. -->
    <style name="Theme.AuraLauncher" parent="Theme.Lumora.Glass">
        <item name="android:windowBackground">@color/nova_bg</item>
        <item name="android:colorBackground">@color/nova_bg</item>
        <item name="android:textColorPrimary">@color/nova_text</item>
        <item name="android:textColorSecondary">@color/nova_text_dim</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="colorPrimary">@color/nova_accent</item>
        <item name="colorPrimaryDark">@color/nova_bg</item>
        <item name="colorAccent">@color/nova_accent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

    <style name="Theme.AuraLauncher.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_glass</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">@color/nova_text</item>
        <item name="android:textColorSecondary">@color/nova_text_dim</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="colorAccent">@color/nova_accent</item>
        <item name="lumoraGlassPanel">@color/glass_panel_fill</item>
        <item name="lumoraGlassCard">@color/glass_card_fill</item>
        <item name="lumoraGlassControl">@color/glass_control_fill</item>
        <item name="lumoraGlassFocus">@color/glass_focus_fill</item>
        <item name="lumoraGlassPill">@color/glass_pill_fill</item>
        <item name="lumoraGlassSheet">@color/glass_sheet_fill</item>
        <item name="lumoraGlassBar">@color/glass_bar_fill</item>
        <item name="lumoraGlassInset">@color/glass_inset_fill</item>
    </style>

    <!-- Reduce transparency: opaque twins of the glass fills, applied over any Lumora theme
         by ui/Glass.applyTheme before the layout inflates. -->
    <style name="ThemeOverlay.Lumora.Solid" parent="">
        <item name="lumoraGlassPanel">@color/glass_panel_solid</item>
        <item name="lumoraGlassCard">@color/glass_card_solid</item>
        <item name="lumoraGlassControl">@color/glass_control_solid</item>
        <item name="lumoraGlassFocus">@color/glass_focus_solid</item>
        <item name="lumoraGlassPill">@color/glass_pill_solid</item>
        <item name="lumoraGlassSheet">@color/glass_sheet_solid</item>
        <item name="lumoraGlassBar">@color/glass_bar_solid</item>
        <item name="lumoraGlassInset">@color/glass_inset_solid</item>
    </style>

    <!-- Shared text styles -->
    <style name="Lumora.Eyebrow">
        <item name="android:textColor">@color/nova_text_muted</item>
        <item name="android:textSize">8sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Lumora.Body">
        <item name="android:textColor">@color/nova_text_dim</item>
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Lumora.Option">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_option_selector</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nova_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
