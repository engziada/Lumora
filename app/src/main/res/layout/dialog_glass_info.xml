<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/infoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/infoMessage"
        style="@style/Lumora.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/infoCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_code_block"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="@color/nova_text"
        android:textIsSelectable="true"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnInfoPrimary"
            style="@style/Lumora.Option"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="120dp"
            android:textColor="@color/nova_accent" />

        <Button
            android:id="@+id/btnInfoClose"
            style="@style/Lumora.Option"
            android:layout_width="wrap_content"
            android:minWidth="100dp"
            android:text="@string/close" />
    </LinearLayout>
</LinearLayout>
