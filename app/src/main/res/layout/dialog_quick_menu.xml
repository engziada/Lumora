<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickShell"
    android:layout_width="680dp" android:layout_height="wrap_content"
    android:layout_marginTop="64dp" android:layout_marginEnd="38dp"
    android:orientation="horizontal" android:background="@drawable/bg_glass_panel"
    android:padding="18dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="210dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingEnd="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quick_title" android:textColor="@color/nova_text"
            android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/quick_shortcut"
            android:textColor="@color/nova_text_dim" android:textSize="9sp" />
        <LinearLayout android:id="@+id/quickTiles" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="18dp" />
        <TextView android:id="@+id/txtQuickStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="@color/nova_text_dim" android:textSize="9sp" />
        <Button android:id="@+id/btnQuickSetup" style="@style/Lumora.Option"
            android:layout_width="match_parent" android:text="@string/quick_setup_button" />
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33F3E6D6" />
    <ScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="350dp"
        android:fillViewport="true" android:paddingStart="22dp" android:clipToPadding="false">
        <LinearLayout android:id="@+id/quickDetail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
