<?xml version="1.0" encoding="utf-8"?>
<!-- Appended to Settings › Appearance (SettingsActivity.bindAppearance). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Lumora.PanelEyebrow"
        android:text="@string/card_effect_label" />

    <Button
        android:id="@+id/btnCardEffect"
        style="@style/Lumora.Option"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp" />

    <TextView
        style="@style/Lumora.Hint"
        android:text="@string/card_effect_hint" />
</LinearLayout>
