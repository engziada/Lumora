<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_bg">

    <ImageView
        android:id="@+id/imgWallpaperBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/imgWallpaperFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Hardware layer: the two full-screen gradients are shaded once. Each partial redraw
         (card effects, particles) then copies the cached texture instead of shading both
         gradients again, which cost about 15 ms per frame on a Fire TV Stick 4K GPU.
         The layer uses about 8 MB of GPU memory while the launcher is visible. -->
    <View
        android:id="@+id/vignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:layerType="hardware" />

    <!-- Header: brand left; settings gear and clock right -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="38dp"
        android:paddingTop="14dp"
        android:paddingEnd="38dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_lumora_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="15dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/ic_lumora_wordmark" />

            <TextView
                style="@style/Lumora.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/brand_tagline" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button android:id="@+id/updateBadge" android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginEnd="8dp" android:paddingHorizontal="14dp" android:text="@string/update_badge" android:textSize="10sp"
            android:textAllCaps="false" android:textColor="@color/nova_text"
            android:background="@drawable/bg_option_selector" android:visibility="gone" />
        <ImageButton
            android:id="@+id/globalSearchButton"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginEnd="8dp" android:padding="10dp"
            android:background="@drawable/bg_gear" android:src="@drawable/ic_search"
            android:contentDescription="@string/global_search" app:tint="@color/nova_text"
            android:nextFocusRight="@id/navQuick" />
        <FrameLayout
            android:id="@+id/navQuick"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_gear"
            android:clickable="true"
            android:focusable="true"
            android:tooltipText="@string/quick_shortcut"
            android:contentDescription="@string/quick_shortcut"
            android:nextFocusRight="@id/btnGear">
            <ImageView
                android:id="@+id/imgNavQuick"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_quick"
                app:tint="@color/nova_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnGear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_gear"
            android:clickable="true"
            android:contentDescription="@string/nav_settings"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                app:tint="@color/nova_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clockView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#990A0D14"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="@color/nova_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, MMM d"
                android:format24Hour="EEE, d MMM"
                android:letterSpacing="0.08"
                android:textColor="@color/nova_text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/greetingBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingTop="4dp"
        android:paddingEnd="38dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:shadowColor="#990A0D14"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:textColor="@color/nova_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGreetingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nova_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Home: focused app as a hero line above one strip of wide glass cards -->
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:clipToPadding="false" android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/greetingBlock"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">
    <LinearLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <FrameLayout android:id="@+id/homeHeroArea" android:layout_width="match_parent" android:layout_height="160dp">
        <LinearLayout android:layout_width="420dp" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:ellipsize="end"
            android:shadowColor="#CC0A0D14"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:singleLine="true"
            android:textColor="@color/nova_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHeroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:shadowColor="#CC0A0D14"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/nova_text_dim"
            android:textSize="10sp" />

        </LinearLayout>
    <include
        android:id="@+id/appPreview"
        layout="@layout/section_app_preview"
        android:layout_width="280dp"
        android:layout_height="157dp"
        android:layout_marginEnd="40dp"
        android:visibility="gone"
        android:layout_gravity="end|center_vertical" />

        </FrameLayout>
        <LinearLayout android:id="@+id/homeSections"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/homeFavoritesSection"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="40dp" android:paddingTop="8dp" android:paddingEnd="40dp"
            android:text="@string/category_favorites" android:textSize="14sp" android:textColor="@color/nova_text" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHome"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />

        </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/btnHomeIptvFavorites"
            style="@style/Lumora.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/nova_text"
            android:visibility="gone" />
    </LinearLayout>
    </ScrollView>

    <!-- Movies: public-domain feature films from the Internet Archive in shelves by genre. The
         focused film's details sit on top; ui/MoviesTab builds the shelves. Like Live TV, the
         greeting hides here so the panel starts just below the header. -->
    <LinearLayout
        android:id="@+id/moviesPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/greetingBlock">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="220dp">

            <TextView
                android:id="@+id/movieEyebrow"
                style="@style/Lumora.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/movieTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:shadowColor="#990A0D14"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:singleLine="true"
                android:textColor="@color/nova_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/movieMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/nova_text_dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/movieSynopsis"
                style="@style/Lumora.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/movieScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/movieShelves"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/txtMoviesStatus"
                style="@style/Lumora.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Apps and Streaming: one grid, adapter swapped per tab -->
    <FrameLayout
        android:id="@+id/gridPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/greetingBlock">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="32dp"
            android:paddingTop="6dp"
            android:paddingEnd="32dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/txtGridEmpty"
            style="@style/Lumora.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Live TV: a Pluto TV style guide. The focused channel's program and a muted preview sit
         on top; categories run down the left; each row shows the program on air and the next
         two. The greeting hides on this tab, so the panel starts just below the header. -->
    <LinearLayout
        android:id="@+id/showsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingEnd="38dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/greetingBlock">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:layout_weight="1">

                <!-- The bottom margin keeps a long synopsis clear of the toolbar. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="38dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/guideEyebrow"
                        style="@style/Lumora.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/guideTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:shadowColor="#990A0D14"
                        android:shadowDy="2"
                        android:shadowRadius="10"
                        android:singleLine="true"
                        android:textColor="@color/nova_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/guideMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/nova_text_dim"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/guideProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="120dp"
                            android:layout_height="3dp"
                            android:layout_marginStart="10dp"
                            android:importantForAccessibility="no"
                            android:max="100"
                            android:maxHeight="3dp"
                            android:minHeight="3dp"
                            android:progressDrawable="@drawable/bg_guide_progress"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/guideSynopsis"
                        style="@style/Lumora.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal">

                    <AutoCompleteTextView
                        android:id="@+id/iptvCountry"
                        style="@style/Lumora.Body"
                        android:layout_width="170dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_option_selector"
                        android:backgroundTint="@null"
                        android:completionThreshold="0"
                        android:focusable="true"
                        android:hint="@string/iptv_country_hint"
                        android:inputType="none"
                        android:nextFocusRight="@id/iptvSearch"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/nova_text"
                        android:textColorHint="@color/nova_text_dim"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/iptvSearch"
                        style="@style/Lumora.Body"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_option_selector"
                        android:backgroundTint="@null"
                        android:hint="@string/iptv_search_placeholder"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:nextFocusLeft="@id/iptvCountry"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/nova_text"
                        android:textColorHint="@color/nova_text_dim"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/iptvRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_option_selector"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/iptv_refresh"
                        android:textAllCaps="false"
                        android:textColor="@color/nova_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Channel art, then a muted low-resolution stream once focus rests (ui/GuidePreview). -->
            <FrameLayout
                android:id="@+id/guidePreview"
                android:layout_width="256dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_poster_frame">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/guidePlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="false"
                    android:visibility="gone"
                    app:resize_mode="zoom"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <ImageView
                    android:id="@+id/guidePreviewArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/guidePreviewInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/nova_text_muted"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/guideRail"
                android:layout_width="168dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <!-- Last child: match_parent takes the width the rail leaves. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerShows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/txtShowsStatus"
                    style="@style/Lumora.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxWidth="520dp"
                    android:accessibilityLiveRegion="polite"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Lumora.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/shows_attribution"
                android:textAllCaps="false"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/onlineProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:accessibilityLiveRegion="polite"
                android:singleLine="true"
                android:textColor="@color/nova_text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtMoveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_glass_pill"
        android:drawablePadding="8dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/move_hint"
        android:textColor="@color/nova_text"
        android:textSize="11sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_act_move"
        app:drawableTint="@color/nova_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom navigation (Settings lives behind the gear next to the clock). The tabs sit in a
         floating glass dock; ui/Frost paints the blurred wallpaper behind it at runtime. -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navDock"
            android:layout_width="740dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavHome"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/txtNavHome"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navShows"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavShows"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_shows" />

                <TextView
                    android:id="@+id/txtNavShows"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_shows" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navFilms"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavFilms"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_film" />

                <TextView
                    android:id="@+id/txtNavFilms"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_movies_tab" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navApps"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavApps"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_apps" />

                <TextView
                    android:id="@+id/txtNavApps"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_apps" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navMovies"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavMovies"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_movies" />

                <TextView
                    android:id="@+id/txtNavMovies"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_streaming" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/quickTooltip"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/bg_glass_pill"
        android:padding="8dp" android:text="@string/quick_shortcut"
        android:textColor="@color/nova_text" android:textSize="9sp"
        android:visibility="gone" android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintEnd_toEndOf="@id/headerBar" />

    <!-- Floating assistant button at the end of the bottom bar, centred on the dock -->
    <FrameLayout
        android:id="@+id/btnAssistant"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_assistant_fab"
        android:clickable="true"
        android:contentDescription="@string/assistant_open"
        android:elevation="10dp"
        android:focusable="true"
        android:nextFocusLeft="@id/navMovies"
        app:layout_constraintBottom_toBottomOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottomNav">

        <ImageView
            android:id="@+id/imgAssistant"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_assistant" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
