<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_bg">

    <ImageView
        android:id="@+id/imgWallpaperBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/imgWallpaperFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/vignetteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <!-- Header: mark, wordmark, tagline, clock -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="38dp"
        android:paddingTop="14dp"
        android:paddingEnd="38dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_lumora_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="15dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/ic_lumora_wordmark" />

            <TextView
                style="@style/Lumora.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.18"
                android:text="@string/brand_tagline"
                android:textSize="6sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clockView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#99140A06"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="@color/nova_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, MMM d"
                android:format24Hour="EEE, d MMM"
                android:letterSpacing="0.08"
                android:textColor="@color/nova_text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/greetingBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingTop="4dp"
        android:paddingEnd="38dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:shadowColor="#99140A06"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:textColor="@color/nova_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGreetingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nova_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFeatured"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/greetingBlock" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/recyclerFeatured" />

    <!-- Shows tab: channel chips, poster grid, attribution -->
    <LinearLayout
        android:id="@+id/showsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/greetingBlock">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="38dp"
            android:paddingEnd="38dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/showsChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerShows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtShowsStatus"
                style="@style/Lumora.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            style="@style/Lumora.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingBottom="4dp"
            android:text="@string/shows_attribution"
            android:textAllCaps="false"
            android:textSize="7sp" />
    </LinearLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_nav_bar"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="780dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavHome"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/txtNavHome"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navShows"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavShows"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_shows" />

                <TextView
                    android:id="@+id/txtNavShows"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_shows" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navApps"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavApps"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_apps" />

                <TextView
                    android:id="@+id/txtNavApps"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_apps" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navMovies"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavMovies"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_movies" />

                <TextView
                    android:id="@+id/txtNavMovies"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_streaming" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navQuick"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavQuick"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_quick" />

                <TextView
                    android:id="@+id/txtNavQuick"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_quick" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                style="@style/Lumora.NavItem">

                <ImageView
                    android:id="@+id/imgNavSettings"
                    style="@style/Lumora.NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/txtNavSettings"
                    style="@style/Lumora.NavLabel"
                    android:text="@string/nav_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
