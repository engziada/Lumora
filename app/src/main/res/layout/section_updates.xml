<?xml version="1.0" encoding="utf-8"?>
<!-- Inserted into Settings › About above the credits (SettingsActivity.bindUpdates). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Lumora.PanelEyebrow"
        android:text="@string/update_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUpdateCheck"
            style="@style/Lumora.Option"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/update_check" />

        <Button
            android:id="@+id/btnUpdateAuto"
            style="@style/Lumora.Option"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtUpdateStatus"
        style="@style/Lumora.Hint" />
</LinearLayout>
