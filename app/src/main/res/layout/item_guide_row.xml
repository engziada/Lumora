<?xml version="1.0" encoding="utf-8"?>
<!-- One guide row: channel tile, the program on air, then the next two. The whole row takes
     focus, so Up and Down move between channels and OK plays one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@drawable/bg_guide_row"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/guideTile"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_guide_cell"
        android:duplicateParentState="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/guideNumber"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/nova_text_muted"
            android:textSize="9sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/guideLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <!-- Channel initials until the logo loads; they stay when there is no logo. -->
            <TextView
                android:id="@+id/guideInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/nova_text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/guideStar"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="@color/nova_accent" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/guideNow"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1.7"
        android:background="@drawable/bg_guide_cell"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/guideNowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/nova_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guideNowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/nova_text_dim"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/guideNowProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:progressDrawable="@drawable/bg_guide_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/guideNext1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_guide_cell"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/guideNext1Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/nova_text_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/guideNext1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/nova_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/guideNext2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_guide_cell"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/guideNext2Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/nova_text_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/guideNext2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/nova_text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
