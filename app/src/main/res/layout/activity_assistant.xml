<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/glass_shade" />

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAssistantMark"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_assistant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_title"
                    android:textColor="@color/nova_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAssistantStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/nova_text_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAssistantClear"
                style="@style/Lumora.Option"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="@string/assistant_clear" />

            <Button
                android:id="@+id/btnAssistantClose"
                style="@style/Lumora.Option"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/close" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollAssistant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/assistantMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/assistantSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_setup_title"
                    android:textColor="@color/nova_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Lumora.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/assistant_setup_message"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAssistantSetup"
                    style="@style/Lumora.Option"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minWidth="200dp"
                    android:text="@string/assistant_setup_button"
                    android:textColor="@color/nova_accent" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/assistantInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputAssistant"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_option_selector"
                android:hint="@string/assistant_hint"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/nova_text"
                android:textColorHint="@color/nova_text_muted"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/btnAssistantPhone"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gear"
                android:clickable="true"
                android:contentDescription="@string/assistant_phone"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgAssistantPhone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_phone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnAssistantMic"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gear"
                android:clickable="true"
                android:contentDescription="@string/assistant_mic"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/nova_text" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnAssistantSend"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gear"
                android:clickable="true"
                android:contentDescription="@string/assistant_send"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgAssistantSend"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_send" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
