<?xml version="1.0" encoding="utf-8"?>
<!-- Inserted into Settings › AI assistant above "Open assistant" (SettingsActivity.bindAssistant). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Lumora.PanelEyebrow"
        android:text="@string/ai_control_label" />

    <com.firestick.aura.launcher.ui.OptionToggleView
        android:id="@+id/toggleAiControl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        app:toggleLabel="@string/ai_control_card" />

    <TextView
        style="@style/Lumora.Hint"
        android:text="@string/ai_control_hint" />
</LinearLayout>
