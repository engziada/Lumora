<?xml version="1.0" encoding="utf-8"?>
<!-- One category of the guide rail: the name, then how many channels it holds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_nav_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/guideRailLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/guide_rail_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/guideRailCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/nova_text_muted"
        android:textSize="9sp" />
</LinearLayout>
