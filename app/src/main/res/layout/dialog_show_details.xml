<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="600dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="horizontal"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgShowPoster"
        android:layout_width="132dp"
        android:layout_height="198dp"
        android:background="@drawable/bg_poster_frame"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtShowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/nova_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtShowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/nova_accent"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtShowEpisode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nova_text_dim"
            android:textSize="10sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/txtShowSummary"
                style="@style/Lumora.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShowOpen"
                style="@style/Lumora.Option"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textColor="@color/nova_accent"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnShowClose"
                style="@style/Lumora.Option"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/show_close" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
