<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/iptvPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/iptvPlayerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="40dp"
        android:background="@drawable/bg_player_top_scrim">

        <TextView
            android:id="@+id/iptvPlayerChannelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nova_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/iptvPlayerCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/nova_text_dim"
            android:textSize="13sp" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/playerPrevious" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/player_previous" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_option_selector" android:layout_marginEnd="6dp" android:textColor="@color/nova_text" />
<Button android:id="@+id/playerNext" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/player_next" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_option_selector" android:layout_marginEnd="6dp" android:textColor="@color/nova_text" />
<Button android:id="@+id/playerAudio" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/player_audio" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_option_selector" android:layout_marginEnd="6dp" android:textColor="@color/nova_text" />
<Button android:id="@+id/playerSubtitles" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/player_subtitles" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_option_selector" android:layout_marginEnd="6dp" android:textColor="@color/nova_text" />
<Button android:id="@+id/playerPicture" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/player_picture" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_option_selector" android:layout_marginEnd="6dp" android:textColor="@color/nova_text" />
<Button android:id="@+id/playerGuide" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/player_guide" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_option_selector" android:layout_marginEnd="6dp" android:textColor="@color/nova_text" />
</LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/iptvPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/bg_dialog_glass"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iptv_playback_failed_title"
            android:textColor="@color/nova_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/iptv_playback_failed_hint"
            android:textColor="@color/nova_text_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/iptvPlayerRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="160dp"
            android:text="@string/iptv_playback_retry" />
    </LinearLayout>

</FrameLayout>
