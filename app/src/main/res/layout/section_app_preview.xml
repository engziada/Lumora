<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating preview window: no frame, padding or elevation, so its content reads as if it hangs
  in space. The transparent 3D particle sphere sits on top. The WebView is not part of this
  layout: {@code AppPreview} creates it lazily and only in videos mode, so particles/off starts
  carry no WebView memory cost (it renders an opaque black surface, see the code).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:descendantFocusability="blocksDescendants">
 <com.firestick.aura.launcher.ui.PreviewParticlesView
     android:id="@+id/previewParticles" android:layout_width="match_parent" android:layout_height="match_parent"
     android:visibility="gone" />
 <FrameLayout android:id="@+id/previewPlayerHost" android:layout_width="match_parent" android:layout_height="match_parent" />
 <TextView android:id="@+id/previewService" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
 <TextView android:id="@+id/previewStatus" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp" android:background="#DD140A06" android:textColor="@color/nova_text" android:textSize="12sp" android:visibility="gone" />
</FrameLayout>
