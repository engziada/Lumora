<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/dialogAppIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nova_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogAppPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nova_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/glass_card_stroke" />

    <Button
        android:id="@+id/btnOptLaunch"
        style="@style/Lumora.Option"
        android:layout_width="match_parent"
        android:layout_marginTop="12dp"
        android:text="@string/action_open"
        android:textColor="@color/nova_accent"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOptMoveLeft"
            style="@style/Lumora.Option"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/action_move_left" />

        <Button
            android:id="@+id/btnOptMoveRight"
            style="@style/Lumora.Option"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_move_right" />
    </LinearLayout>

    <Button
        android:id="@+id/btnOptToggleFavorite"
        style="@style/Lumora.Option"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="@string/action_favorite" />

    <Button
        android:id="@+id/btnOptUninstall"
        style="@style/Lumora.Option"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="@string/action_uninstall"
        android:textColor="@color/state_error" />

    <Button
        android:id="@+id/btnOptForceUninstall"
        style="@style/Lumora.Option"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="@string/action_force_uninstall"
        android:textColor="@color/nova_text_dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOptHide"
            style="@style/Lumora.Option"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/action_hide"
            android:textColor="@color/nova_text_dim" />

        <Button
            android:id="@+id/btnOptAppInfo"
            style="@style/Lumora.Option"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_info"
            android:textColor="@color/nova_text_dim" />
    </LinearLayout>
</LinearLayout>
