<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="430dp"
    android:layout_height="350dp"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/country_picker_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/nova_text" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ScrollView
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/countryLetters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
        <ListView
            android:id="@+id/countryPickerList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:listSelector="@drawable/bg_option_selector"
            android:choiceMode="singleChoice"
            android:scrollbars="vertical" />
    </LinearLayout>
</LinearLayout>
