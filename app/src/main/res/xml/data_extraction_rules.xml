<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the OpenRouter key never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lumora_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lumora_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
