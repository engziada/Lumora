<?xml version="1.0" encoding="utf-8"?>
<!-- Events are limited to window changes of the stock Fire TV home; no window content is read.
     Key filtering is used only to recognise the assistant button (see QuickActionService). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_service_description_keys"
    android:notificationTimeout="100"
    android:packageNames="com.amazon.tv.launcher,com.amazon.firehomestarter" />
