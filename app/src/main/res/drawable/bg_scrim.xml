<?xml version="1.0" encoding="utf-8"?>
<!-- Warm readability scrim over the wallpaper: darker at the header and the navigation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#33140A06"
                android:endColor="#F0140A06"
                android:startColor="#B8140A06"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#00140A06"
                android:endColor="#00140A06"
                android:startColor="#99140A06"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
