<?xml version="1.0" encoding="utf-8"?>
<!-- Cool ink readability scrim over the wallpaper: darker at the header and the navigation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1A0A0D14"
                android:endColor="#BF0A0D14"
                android:startColor="#990A0D14"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#000A0D14"
                android:endColor="#000A0D14"
                android:startColor="#800A0D14"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
