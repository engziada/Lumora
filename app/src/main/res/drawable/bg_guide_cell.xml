<?xml version="1.0" encoding="utf-8"?>
<!-- A guide cell. The logo and on-air cells copy the row's focus; later programs stay calm. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lumoraGlassFocus" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/lumoraGlassCard" />
            <stroke android:width="1dp" android:color="@color/glass_edge_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
