<?xml version="1.0" encoding="utf-8"?>
<!-- A guide row: the accent ring marks the focused channel; its cells stay glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_wash" />
            <stroke android:width="2dp" android:color="@color/nova_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_pressed_fill" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
