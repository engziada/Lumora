<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_card_hi" />
            <stroke android:width="2dp" android:color="@color/nova_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_surface_2" />
            <stroke android:width="1dp" android:color="@color/nova_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
