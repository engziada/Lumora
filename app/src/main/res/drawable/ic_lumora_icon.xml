<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: espresso tile with an amber glow and the vector mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="108dp" android:height="108dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF120905"
                android:startColor="#FF2E1A10" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:width="108dp" android:height="108dp">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.52"
                android:centerY="0.56"
                android:endColor="#00E3A15A"
                android:gradientRadius="60dp"
                android:startColor="#47E3A15A"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:width="99dp"
        android:height="99dp"
        android:drawable="@drawable/ic_lumora_mark"
        android:gravity="center" />
</layer-list>
