<?xml version="1.0" encoding="utf-8"?>
<!-- Floating assistant button: glass disc, amber ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/nova_card_hi" />
            <stroke android:width="2dp" android:color="@color/nova_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_plate" />
            <stroke android:width="1dp" android:color="@color/glass_card_stroke" />
        </shape>
    </item>
</selector>
