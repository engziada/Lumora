<?xml version="1.0" encoding="utf-8"?>
<!-- Glass tile behind app icons and home cards. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#73140A06" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="300"
                android:endColor="#08F3E6D6"
                android:startColor="#2EF3E6D6" />
            <stroke android:width="1dp" android:color="#40F3E6D6" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
