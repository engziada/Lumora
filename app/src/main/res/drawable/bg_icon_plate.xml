<?xml version="1.0" encoding="utf-8"?>
<!-- Glass tile behind app icons and home cards: ink glass, diagonal sheen, light edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/lumoraGlassCard" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:endColor="#08FFFFFF" android:startColor="#2EFFFFFF" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
