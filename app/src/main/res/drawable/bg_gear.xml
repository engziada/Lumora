<?xml version="1.0" encoding="utf-8"?>
<!-- Round header buttons over the wallpaper: dark glass disc, light wash and ice ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/lumoraGlassBar" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/glass_focus_fill" />
                    <stroke android:width="2dp" android:color="@color/nova_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/lumoraGlassBar" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
        </shape>
    </item>
</selector>
