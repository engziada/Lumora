<?xml version="1.0" encoding="utf-8"?>
<!--
  Thin glowing ring, tinted with the theme colour at runtime. The view sits on the outer edge of
  the app tile: the bright core line and the soft glow hug that edge exactly (no inset), and a
  faint inner halo bleeds onto the plate so the ring reads on both bright and dark icons. No fill,
  so the card itself is not tinted.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#2EFFFFFF" />
            <corners android:radius="23.5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="#47FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="4.75dp"
        android:left="4.75dp"
        android:right="4.75dp"
        android:top="4.75dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#2EFFFFFF" />
            <corners android:radius="19.25dp" />
        </shape>
    </item>
</layer-list>
