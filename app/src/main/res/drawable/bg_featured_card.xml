<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="#2A3550"
                android:endColor="#161F33"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#8B7CFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="#1A2434"
                android:endColor="#0E1524"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#26334A" />
        </shape>
    </item>
</selector>
