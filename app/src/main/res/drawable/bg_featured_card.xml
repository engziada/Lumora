<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF2A170E"
                android:startColor="#FF4A2C1A" />
            <stroke android:width="2dp" android:color="@color/nova_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#E61E110B"
                android:startColor="#E6362014" />
            <stroke android:width="1dp" android:color="@color/glass_card_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
