<?xml version="1.0" encoding="utf-8"?>
<!-- Dense glass for panels over video or other apps, where no blurred backdrop exists. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/lumoraGlassSheet" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="@color/glass_sheen" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
