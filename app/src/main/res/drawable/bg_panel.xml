<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A61E110B" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00F3E6D6"
                android:startColor="#17F3E6D6" />
            <stroke android:width="1dp" android:color="#33F3E6D6" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
